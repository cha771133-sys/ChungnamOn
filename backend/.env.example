# JWT 서명에도 사용합니다. 배포 시 32바이트 이상의 무작위 비밀값으로 교체하세요.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 없으면 Vercel 미리보기 주소 기본 패턴을 사용합니다.
# CORS_ALLOWED_ORIGIN_REGEXES=^https://chungnam-on-[a-z0-9-]+-cha771133-1587s-projects\.vercel\.app$

# 없으면 SQLite를 사용합니다.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# P2-13: dummy(기본, 로컬 고정 답변) | rag(backend/ai/chatbot). 그 밖의 값은 503으로 차단합니다.
CHATBOT_AI_MODE=dummy
# 문서 파이프라인 공식 자료 대조: dummy(기본) | rag. 챗봇 근거 기반 답변은 rag 검증이 연결한 자료만 출처로 씁니다.
DOCUMENTS_VERIFY_MODE=dummy

# --- 챗봇 AI (backend/ai/chatbot) ---
# LLM: anthropic(배포) / ollama(로컬 개발) / mock(테스트 전용). 비워 두면 rag 모드에서 오류가 납니다.
AI_LLM_PROVIDER=
AI_OLLAMA_URL=
AI_OLLAMA_MODEL=
AI_OLLAMA_NUM_CTX=
AI_REQUEST_TIMEOUT=
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=

# 임베딩: gemini(gemini-embedding-001, 768) / ollama(bge-m3, 1024) / fastembed / hash(테스트)
# 임베딩 모델·차원을 바꾸면 build_source_chunks()로 청크 임베딩을 다시 만들어야 합니다.
AI_EMBEDDER=
GEMINI_API_KEY=
AI_GEMINI_EMBED_MODEL=
AI_OLLAMA_EMBED_MODEL=
AI_EMBED_DIM=

# 검색: db(공식 자료 테이블) / memory(.md 폴더, Django 없이)
AI_RETRIEVER=
AI_KB_DIR=
AI_TOP_K=
AI_MIN_SCORE=

# 문서 OCR. 비워 두면 dummy로 동작합니다. 실제 호출은 clova이며 아래 두 값이 필요합니다.
OCR_MODE=
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=

# Firebase 발송 시에만 필요합니다. 실제 JSON이나 비밀키를 이 파일에 넣지 마세요.
# Railway 비밀 환경변수에 서비스 계정 JSON을 넣거나, ADC 파일 경로를 설정하세요.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=
